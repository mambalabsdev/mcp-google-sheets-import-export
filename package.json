{
  "name": "@mambalabsdev/mcp-google-sheets-import-export",
  "version": "1.0.3",
  "description": "MCP server for Google Sheets Import and Export. Read a Google Sheet into rows or write rows into a sheet, on your own Google credentials. Runs on Apify.",
  "type": "module",
  "bin": {
    "mcp-google-sheets-import-export": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google sheets",
    "spreadsheet",
    "export dataset",
    "import csv",
    "sheets api",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/google-sheets-import-export",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-google-sheets-import-export"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-google-sheets-import-export"
}
